rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then Publish.
//
// There are no logins, so these rules can't tell family members apart. What they
// do: allow only the two collections the app uses, only the fields it writes,
// keep a day's letter and prompts from being changed once rolled, and never
// allow deleting anything.
service cloud.firestore {
  match /databases/{database}/documents {

    match /players/{id} {
      allow read: if true;
      allow create, update: if id.matches('^[a-z][a-z0-9]{0,23}$')
        && request.resource.data.keys().hasOnly(['name', 'lastSeen'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30;
      allow delete: if false;
    }

    match /days/{day} {
      allow read: if true;

      // The first person of the day rolls the letter.
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['letter', 'prompts', 'rolledBy', 'rolledAt', 'title'])
        && request.resource.data.letter is string
        && request.resource.data.letter.matches('^[A-Z]$')
        && request.resource.data.prompts is list
        && request.resource.data.prompts.size() == 5;

      // Cards, flags, "same as" merges and admin overrides are added later,
      // but the roll itself can't be redone.
      allow update: if request.resource.data.keys().hasOnly(
          ['letter', 'prompts', 'rolledBy', 'rolledAt', 'title', 'cards', 'flags', 'merges', 'overrides'])
        && request.resource.data.letter == resource.data.letter
        && request.resource.data.prompts == resource.data.prompts
        && request.resource.data.rolledAt == resource.data.rolledAt;

      allow delete: if false;
    }
  }
}
