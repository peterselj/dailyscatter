rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then Publish.
//
// There are no logins, so these rules can't tell family members apart. What they
// do: allow only the collections the app uses, only the fields it writes, keep a
// day's letter and prompts from being changed once rolled, never allow deleting
// real games, and keep the clock honest: the database stamps when each card
// starts, and answers can't change once the timer (plus a few minutes' grace)
// runs out, after "I'm done", or after the day ends. Playtest data (pt_*)
// follows the same rules but can be wiped.
service cloud.firestore {
  match /databases/{database}/documents {

    function playerOk(id) {
      return id.matches('^[a-z][a-z0-9]{0,23}$')
        && request.resource.data.keys().hasOnly(['name', 'lastSeen'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30;
    }

    // The first person of the day rolls the letter.
    function rollOk(day) {
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['letter', 'prompts', 'rolledBy', 'rolledAt', 'title'])
        && request.resource.data.letter is string
        && request.resource.data.letter.matches('^[A-Z]$')
        && request.resource.data.prompts is list
        && request.resource.data.prompts.size() == 5;
    }

    // Cards, flags, "same as" merges and admin overrides are added later,
    // but the roll itself can't be redone.
    function dayUpdateOk(day, extraKeys) {
      return request.resource.data.keys().hasOnly(
          ['letter', 'prompts', 'rolledBy', 'rolledAt', 'title', 'cards', 'flags', 'merges', 'overrides', 'editing'].concat(extraKeys))
        && request.resource.data.letter == resource.data.letter
        && request.resource.data.prompts == resource.data.prompts
        && request.resource.data.rolledAt == resource.data.rolledAt
        && cardsOk(day);
    }

    // --- Cards and the clock ---
    // Keep these two in step with js/config.js and js/prompts.js (a unit test checks).
    function helperPlayers() { return ['kenny']; }                 // ASSISTED_PLAYERS: no timer
    function timerSeconds(day) { return {'2026-11-22': 360}.get(day, 180); } // special cards' timerSeconds, else TIMER_SECONDS
    function grace() { return duration.value(3, 'm'); }            // slow networks, the last save after "Time's up"

    // The end of the day: midnight Eastern is 04:00 or 05:00 UTC the next morning; allow the later.
    function dayEnd(day) {
      let p = day.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(29, 'h');
    }

    // Each write changes at most one card and names it in `editing`, so the rules
    // know which card to check. No card is ever removed.
    function cardsOk(day) {
      let before = resource.data.get('cards', {});
      let after = request.resource.data.get('cards', {});
      let pid = request.resource.data.get('editing', '');
      let changed = after.diff(before).affectedKeys();
      return changed.size() == 0 || (
        after.keys().hasAll(before.keys())
        && changed.hasOnly([pid])
        && cardOk(day, pid, before.get(pid, {}), after[pid]));
    }

    function cardOk(day, pid, was, card) {
      return card.keys().hasOnly(['name', 'startedAt', 'serverStartedAt', 'answers', 'updatedAt', 'skipped', 'assisted', 'doneAt'])
        && request.time < dayEnd(day) + grace()
        && (pid in helperPlayers() || timedCardOk(day, was, card));
    }

    // A timed card. Starting it, the database stamps serverStartedAt itself;
    // after that the start can't move, and answers can change only until the
    // timer (plus grace) runs out, and not at all after "I'm done".
    function timedCardOk(day, was, card) {
      let started = was.get('serverStartedAt', null);
      return card.get('assisted', false) == false
        && card.get('skipped', false) == false
        && (started == null
          ? (was.get('startedAt', null) == null
            // Starting now.
            ? card.get('serverStartedAt', null) == request.time && card.get('startedAt', null) is int
            // Started before the clock rules (no stamp): it can be finished today, as it was.
            : !('serverStartedAt' in card) && card.get('startedAt', null) == was.startedAt)
          : card.get('serverStartedAt', null) == started
            && card.get('startedAt', null) == was.get('startedAt', null)
            && (was.get('doneAt', null) == null || card.get('doneAt', null) == was.doneAt)
            && (card.get('answers', null) == was.get('answers', null)
              || (was.get('doneAt', null) == null
                && request.time < started + duration.value(timerSeconds(day), 's') + grace())));
    }

    // --- The real game ---
    match /players/{id} {
      allow read: if true;
      allow create, update: if playerOk(id);
      allow delete: if false;
    }
    match /days/{day} {
      allow read: if true;
      allow create: if rollOk(day);
      allow update: if dayUpdateOk(day, []);
      allow delete: if false;
    }

    // Who counts toward "everyone's done" (set by the admin in Settings).
    function familyOk() {
      return request.resource.data.keys().hasOnly(['members', 'updatedAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 30;
    }
    match /meta/family {
      allow read: if true;
      allow create, update: if familyOk();
      allow delete: if false;
    }

    // WhatsApp posting job: one record per posted day (or week), so nothing is posted twice.
    function postOk() {
      return request.resource.data.keys().hasOnly(['status', 'at', 'attempts', 'error'])
        && request.resource.data.status in ['sending', 'sent', 'failed'];
    }
    match /posts/{id} {
      allow read: if true;
      allow create, update: if postOk();
      allow delete: if false;
    }

    // --- Playtest (practice) data ---
    match /pt_players/{id} {
      allow read: if true;
      allow create, update: if playerOk(id);
      allow delete: if true;
    }
    match /pt_days/{day} {
      allow read: if true;
      allow create: if rollOk(day);
      allow update: if dayUpdateOk(day, ['revealedAt']);
      allow delete: if true;
    }
    match /pt_meta/family {
      allow read: if true;
      allow create, update: if familyOk();
      allow delete: if true;
    }
    match /pt_posts/{id} {
      allow read: if true;
      allow create, update: if postOk();
      allow delete: if true;
    }
    match /pt_meta/clock {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['dayShift'])
        && request.resource.data.dayShift is int
        && request.resource.data.dayShift >= 0
        && request.resource.data.dayShift < 400;
      allow delete: if true;
    }
  }
}
